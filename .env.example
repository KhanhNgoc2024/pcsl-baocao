# Database
DATABASE_URL="postgresql://pcsl_app:pcsl_dev_pw@localhost:5432/pcsl_baocao?schema=public"

# Auth
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25

# SMTP (tuỳ chọn - để trống nếu chưa dùng email nhắc hạn)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PCSL Bao Cao <no-reply@pcsonla.local>"

# Server
PORT=3000
CORS_ORIGIN="http://localhost:5173"
